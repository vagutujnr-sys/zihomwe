"use client";

import { useEffect, useMemo, useState } from "react";
import {
  Search,
  MessageSquarePlus,
  CheckCheck,
  Users,
  Bell,
  MoreHorizontal,
  Plus,
  X,
  UserPlus,
  Edit3,
} from "lucide-react";

import { ChatView } from "./chatview";

interface ChatItem {
  id: number;
  name: string;
  message: string;
  time: string;
  unread: number;
  online: boolean;
  group: boolean;
  typing?: boolean;
}

const chats: ChatItem[] = [
  {
    id: 1,
    name: "John Mapfumo",
    message: "See you at the event tomorrow.",
    time: "18:30",
    unread: 2,
    online: true,
    group: false,
  },
  {
    id: 2,
    name: "Youth Council",
    message: "Great progress on the mobilisation project!",
    time: "17:45",
    unread: 5,
    online: false,
    group: true,
  },
  {
    id: 3,
    name: "Grace Mhlanga",
    message: "Thanks for the update.",
    time: "Yesterday",
    unread: 0,
    online: true,
    group: false,
  },
  {
    id: 4,
    name: "Economic Team",
    message: "Budget allocation approved.",
    time: "Mon",
    unread: 1,
    online: false,
    group: true,
  },
  {
    id: 5,
    name: "Tawanda Dube",
    message: "Can we meet after the community gathering?",
    time: "Sun",
    unread: 0,
    online: false,
    group: false,
  },
  {
    id: 6,
    name: "Sarah Ncube",
    message: "Typing...",
    time: "Now",
    unread: 0,
    online: true,
    typing: true,
    group: false,
  },
];

const avatarColors = [
  "from-[#8B1E3F] to-[#C94C6A]",
  "from-purple-500 to-indigo-500",
  "from-emerald-500 to-green-600",
  "from-orange-500 to-red-500",
  "from-blue-500 to-cyan-500",
];

interface ChatsPageProps {
  onChatViewChange?: (isOpen: boolean) => void;
}

export function ChatsPage({ onChatViewChange }: ChatsPageProps) {
  const [selectedChat, setSelectedChat] = useState<ChatItem | null>(null);
  const [search, setSearch] = useState("");
  const [fabOpen, setFabOpen] = useState(false);

  useEffect(() => {
    onChatViewChange?.(Boolean(selectedChat));
  }, [selectedChat, onChatViewChange]);

  const filteredChats = useMemo(
    () =>
      chats.filter((chat) =>
        chat.name.toLowerCase().includes(search.toLowerCase())
      ),
    [search]
  );

  if (selectedChat) {
    return <ChatView chat={selectedChat} onBack={() => setSelectedChat(null)} />;
  }

  return (
    <div className="relative h-screen bg-slate-50 overflow-hidden">
      <div className="pointer-events-none absolute inset-0">
        <div className="absolute -top-40 -right-40 h-96 w-96 rounded-full bg-[#8B1E3F]/10 blur-3xl" />
        <div className="absolute top-80 -left-40 h-72 w-72 rounded-full bg-pink-300/20 blur-3xl" />
      </div>

      <div className="relative z-10 h-full overflow-hidden">
        <div className="h-full overflow-y-auto pb-28">
          <div className="sticky top-0 z-30 bg-white/80 backdrop-blur-xl border-b border-slate-200">
            <div className="px-5 pt-8 pb-5">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm text-slate-500">Welcome back</p>
                  <h1 className="mt-1 text-3xl font-bold tracking-tight text-slate-900">
                    Messages
                  </h1>
                </div>
                <button className="flex h-11 w-11 items-center justify-center rounded-2xl bg-white shadow-md transition hover:scale-105">
                  <Bell size={20} className="text-slate-700" />
                </button>
              </div>

              <div className="relative mt-6">
                <Search size={18} className="absolute left-5 top-1/2 -translate-y-1/2 text-slate-400" />
                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Search conversations..."
                  className="h-14 w-full rounded-2xl bg-white pl-14 pr-5 text-sm shadow-lg outline-none border border-slate-100 focus:ring-4 focus:ring-[#8B1E3F]/10"
                />
              </div>
            </div>

            <div className="px-5 pb-5 border-t border-slate-200">
              <div className="mb-4 flex items-center justify-between">
                <h2 className="text-sm font-bold uppercase tracking-wider text-slate-500">Active Now</h2>
                <button className="text-sm font-semibold text-[#8B1E3F]">View All</button>
              </div>

              <div className="flex gap-4 overflow-x-auto pb-3 scrollbar-hide">
                <button className="flex w-[72px] flex-shrink-0 flex-col items-center">
                  <div className="flex h-16 w-16 items-center justify-center rounded-3xl border-2 border-dashed border-[#8B1E3F]/40 bg-white shadow">
                    <Plus size={24} className="text-[#8B1E3F]" />
                  </div>
                  <span className="mt-2 text-xs text-slate-500">New</span>
                </button>

                {chats.filter((chat) => chat.online).map((chat, index) => {
                  const initials = chat.name.split(" ").map((n) => n[0]).join("").substring(0, 2);
                  return (
                    <button
                      key={chat.id}
                      onClick={() => setSelectedChat(chat)}
                      className="flex w-[72px] flex-shrink-0 flex-col items-center"
                    >
                      <div className="relative">
                        <div className={`flex h-16 w-16 items-center justify-center rounded-3xl bg-gradient-to-br ${avatarColors[index % avatarColors.length]} text-white font-bold shadow-lg`}>
                          {chat.group ? <Users size={24} /> : initials}
                        </div>
                        <span className="absolute bottom-1 right-1 h-4 w-4 rounded-full border-2 border-white bg-green-500" />
                      </div>
                      <span className="mt-2 w-full truncate text-center text-xs font-medium text-slate-700">
                        {chat.name.split(" ")[0]}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          <section className="mt-0 px-5 pt-6">
            <div className="mb-5 flex items-center justify-between">
              <div>
                <h2 className="text-xl font-bold text-slate-900">Recent Conversations</h2>
                <p className="mt-1 text-sm text-slate-500">{filteredChats.length} conversations</p>
              </div>
              <button className="flex h-10 w-10 items-center justify-center rounded-xl bg-white shadow">
                <MoreHorizontal size={20} />
              </button>
            </div>

            <div className="space-y-2">
              {filteredChats.map((chat, index) => {
                const initials = chat.name.split(" ").map((n) => n[0]).join("").substring(0, 2);
                return (
                  <button
                    key={chat.id}
                    onClick={() => setSelectedChat(chat)}
                    className="group flex w-full items-center gap-4 rounded-3xl px-3 py-4 text-left transition duration-300 hover:bg-white hover:shadow-lg active:scale-[0.98]"
                  >
                    <div className="relative flex-shrink-0">
                      <div className={`flex h-16 w-16 items-center justify-center rounded-3xl bg-gradient-to-br ${avatarColors[index % avatarColors.length]} text-white font-bold shadow-md`}>
                        {chat.group ? <Users size={24} /> : initials}
                      </div>
                      {chat.online && !chat.group && <span className="absolute bottom-1 right-1 h-4 w-4 rounded-full border-2 border-white bg-green-500" />}
                    </div>

                    <div className="min-w-0 flex-1">
                      <div className="flex items-center justify-between">
                        <h3 className={`truncate text-[15px] ${chat.unread ? "font-bold text-slate-900" : "font-semibold text-slate-800"}`}>{chat.name}</h3>
                        <span className={`text-xs ${chat.unread ? "font-bold text-[#8B1E3F]" : "text-slate-400"}`}>{chat.time}</span>
                      </div>
                      <div className="mt-2 flex items-center gap-2">
                        {!chat.group && <CheckCheck size={15} className="text-[#8B1E3F]" />}
                        {chat.typing ? (
                          <span className="text-sm font-medium italic text-green-600">typing...</span>
                        ) : (
                          <p className="truncate text-sm text-slate-500">{chat.message}</p>
                        )}
                      </div>
                    </div>

                    {chat.unread > 0 && (
                      <div className="flex h-7 min-w-7 items-center justify-center rounded-full bg-green-500 px-2 text-xs font-bold text-white shadow">
                        {chat.unread}
                      </div>
                    )}
                  </button>
                );
              })}
            </div>

            {filteredChats.length === 0 && (
              <div className="mt-16 flex flex-col items-center justify-center px-6 text-center">
                <div className="flex h-24 w-24 items-center justify-center rounded-full bg-white shadow-xl">
                  <Search size={36} className="text-slate-300" />
                </div>
                <h3 className="mt-6 text-lg font-bold text-slate-800">No conversations found</h3>
                <p className="mt-2 text-sm text-slate-500">Try searching with another name.</p>
              </div>
            )}
          </section>
        </div>
      </div>

      <div className="fixed bottom-8 right-6 z-50 flex flex-col items-end gap-3">
        {fabOpen && (
          <>
            <button className="flex items-center gap-3 rounded-2xl bg-white px-5 py-3 shadow-xl transition hover:-translate-y-1">
              <UserPlus size={18} className="text-[#8B1E3F]" />
              <span className="text-sm font-semibold text-slate-800">New Chat</span>
            </button>
            <button className="flex items-center gap-3 rounded-2xl bg-white px-5 py-3 shadow-xl transition hover:-translate-y-1">
              <Users size={18} className="text-[#8B1E3F]" />
              <span className="text-sm font-semibold text-slate-800">New Group</span>
            </button>
            <button className="flex items-center gap-3 rounded-2xl bg-white px-5 py-3 shadow-xl transition hover:-translate-y-1">
              <Edit3 size={18} className="text-[#8B1E3F]" />
              <span className="text-sm font-semibold text-slate-800">Broadcast</span>
            </button>
          </>
        )}
        <button
          onClick={() => setFabOpen(!fabOpen)}
          className="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-[#8B1E3F] to-[#C94C6A] text-white shadow-2xl transition-all duration-300 hover:scale-110 active:scale-95"
        >
          {fabOpen ? <X size={28} /> : <MessageSquarePlus size={28} />}
        </button>
      </div>
    </div>
  );
}
